                    </privilege>
                    <privilege>
                        <read-acl/>
                    </privilege>
                    <privilege>
                        <read-current-user-privilege-set/>
                    </privilege>
                </current-user-privilege-set>
                <owner>
                    <href>/caldav/principal/user/</href>
                </owner>
            </prop>
            <status>HTTP/1.1 200 OK</status>
        </propstat>
    </response>
