BEGIN:VALARM&#13;
TRIGGER;VALUE=DURATION:-PT0M&#13;
ACTION:DISPLAY&#13;
DESCRIPTION:🎂 John Doe&#13;
END:VALARM&#13;
END:VEVENT&#13;
END:VCALENDAR&#13;
</CAL:calendar-data>
