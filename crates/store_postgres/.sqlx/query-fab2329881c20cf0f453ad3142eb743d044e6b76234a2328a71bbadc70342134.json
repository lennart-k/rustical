  "query": "\n                SELECT principal, cal_id, id, (deleted_at IS NOT NULL) AS \"deleted!\"\n                    FROM calendarobjects\n                    WHERE (principal, cal_id, id) NOT IN (\n                        SELECT DISTINCT principal, cal_id, object_id FROM calendarobjectchangelog\n                    )\n                ;\n                ",
