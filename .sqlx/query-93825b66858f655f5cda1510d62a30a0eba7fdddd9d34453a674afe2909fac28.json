  "query": "SELECT s.owner, s.addressbook_id, s.sharee, s.name, s.access, s.displayname, s.color, s.created_at AS \"created_at: NaiveDateTime\", s.created_by\n                    FROM addressbook_shares AS s\n                    JOIN addressbooks AS a ON (a.principal, a.id) = (s.owner, s.addressbook_id)\n                    WHERE s.sharee = ? AND a.deleted_at IS NULL\n                    ORDER BY s.name",
