  "query": "SELECT s.owner, s.cal_id, s.sharee, s.name, s.access, s.displayname, s.color, s.\"order\", s.created_at AS \"created_at: NaiveDateTime\", s.created_by\n                    FROM calendar_shares AS s\n                    JOIN calendars AS c ON (c.principal, c.id) = (s.owner, s.cal_id)\n                    WHERE s.sharee = ? AND c.deleted_at IS NULL\n                    ORDER BY s.name",
